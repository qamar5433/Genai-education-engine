# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# ── Brevo Email (SMTP) ────────────────────────────────────────────────────────
# Sign up free at https://app.brevo.com
# Go to: SMTP & API → SMTP → Generate SMTP Key
BREVO_SMTP_LOGIN=your-brevo-account-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key

# ── AI APIs (at least one required) ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ── Deployment (set automatically on Render) ──────────────────────────────────
# RENDER=true
